#!/usr/bin/env bash
# Glasswall shortcuts, by short name. Add a line, get a command.
#
#   ./runs            list them
#   ./runs demo       open one
#   ./runs demo sample  open several, one tab each
#
# Each entry is:  name | profile | source | output
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"

# Your own shortcuts. Nothing here is shipped: edit the buckets and the rows to
# match the exports you actually review, or delete the file and pass locations
# to ./glasswall directly.
BUCKET=s3://your-bucket
PREFIX=$BUCKET/exports

RUNS=(
  "demo    | default | $PREFIX/demo        | $PREFIX/demo-pii"
  "sample  | default | $PREFIX/sample      | $PREFIX/sample-pii"
)

row() { for r in "${RUNS[@]}"; do [ "$(echo "$r" | cut -d'|' -f1 | xargs)" = "$1" ] && echo "$r" && return; done; return 1; }

if [ $# -eq 0 ]; then
  printf "\n  %-9s %-6s %s\n" NAME PROFILE SOURCE
  for r in "${RUNS[@]}"; do
    printf "  %-9s %-6s %s\n" "$(echo "$r"|cut -d'|' -f1|xargs)" "$(echo "$r"|cut -d'|' -f2|xargs)" "$(echo "$r"|cut -d'|' -f3|xargs)"
  done
  printf "\n  ./runs s1 sample     opens those two, a tab each\n\n"
  exit 0
fi

ARGS=(); PROFILE=""
for name in "$@"; do
  r="$(row "$name")" || { echo "  no run called '$name' — ./runs to list them"; exit 1; }
  PROFILE="$(echo "$r" | cut -d'|' -f2 | xargs)"
  ARGS+=(--pair "$(echo "$r" | cut -d'|' -f3 | xargs)" "$(echo "$r" | cut -d'|' -f4 | xargs)")
done
exec python3 "$HERE/glasswall.py" "${ARGS[@]}" --profile "$PROFILE"
